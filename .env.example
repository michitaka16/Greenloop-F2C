# ============================================================
# GreenLoop Farm OS — Environment Configuration
# Copy to .env and fill in values:  cp .env.example .env
# ============================================================

# ── Data & Model Paths ─────────────────────────────────────
# DATA_DIR=data
# MODELS_DIR=models

# ── Streamlit ──────────────────────────────────────────────
# STREAMLIT_SERVER_PORT=8501

# ── LLM Configuration ─────────────────────────────────────
# Select active provider: openai | zai | minimax | anthropic | claude
# LLM_PROVIDER=anthropic

# Generic fallback (used when provider-specific model is unset)
# DEFAULT_LLM_MODEL=glm-4.6

# OpenAI (optional)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# Z.ai / GLM (Anthropic-compatible endpoint — works with Coding Plan keys)
#   Docs: https://docs.z.ai/guides/overview/quick-start
# ZAI_API_KEY=your-zai-key-here
# ZAI_BASE_URL=https://api.z.ai/api/anthropic
# ZAI_MODEL=glm-5.1

# MiniMax (Anthropic-compatible endpoint — required for M2.x models)
#   International: https://api.minimax.io/anthropic
# MINIMAX_API_KEY=your-minimax-key-here
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Anthropic / Claude (direct API — ANTHROPIC_API_KEY also used by Layer 5 RAG)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6
